			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1762423990070</Id>
					<Name><![CDATA[updateVisuals]]></Name>
					<X>-100</X><Y>40</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[/**
 * Met à jour l'interface visuelle du nœud.
 * Cette fonction permet de visualiser l'état actuel de la chaîne locale.
 */

// 1. Récupération de la taille de la blockchain
// On compte le nombre de blocs validés dans notre liste locale.
int chainSize = blockchain.size();

// 2. Mise à jour de l'affichage
// On modifie le texte sur l'agent pour montrer la hauteur de la chaîne (Block Height).
chainLengthText.setText("Blocks: " + chainSize);

]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1768513474134</Id>
					<Name><![CDATA[effectuerMinage]]></Name>
					<X>-100</X><Y>100</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// =========================================================
// MOTEUR PROOF OF STAKE : FORGEAGE DU BLOC (Minting)
// =========================================================
if (this.estConnecte == false) return;

// 1. Déterminer le hash précédent
String previousHash = "0";
if (!this.blockchain.isEmpty()) {
    previousHash = this.blockchain.get(this.blockchain.size() - 1).hash;
}

// 2. Création INSTANTANÉE du bloc (Aucune force brute !)
Block nouveauBloc = new Block("Transactions du Slot", previousHash);

// Le hash est calculé une seule fois pour garantir l'intégrité
nouveauBloc.hash = nouveauBloc.calculateHash();

// 3. Validation locale et Récompense
this.blockchain.add(nouveauBloc);

// La récompense de Staking sur Ethereum (ex: 0.05 ETH par bloc)
double RECOMPENSE_POS = 0.05;
this.balance = this.balance + RECOMPENSE_POS; 

this.recompensesTotales = this.recompensesTotales + RECOMPENSE_POS;

// 4. Mise à jour visuelle du gagnant
traceln("🔨 Le Validateur " + this.getIndex() + " a forgé avec succès le bloc " + (this.blockchain.size() - 1) + " !");

// On affiche la vraie taille de la chaîne, et on met à jour tout le visuel
updateVisuals(); 

// Clignotement Vert
voyant_rect.setFillColor(lightGreen); 
revertColorEvent.restart(1.0, SECOND); 

// 5. Propagation Vraie Vague (Gossip Protocol)
for (Agent voisin : getConnections()) {
    if (main.chk_simulerFork.isSelected()) {
        create_SendWithDelayEvent(uniform(1.0, 3.0), SECOND, nouveauBloc, voisin);
    } else {
        Messager m = main.add_messagers();
        m.setXY(this.getX(), this.getY());
        m.cible = (noeud) voisin;
        m.blocTransporte = nouveauBloc;
        m.expediteur = this; // L'enveloppe mémorise le tireur !
        m.moveTo(voisin.getX(), voisin.getY());
    }
}]]></Body>
				</Function>
			</Functions>


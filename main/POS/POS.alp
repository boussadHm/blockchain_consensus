						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_SECOND]]></Unit>
						</Rate>
						<Id>1762077841579</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1762156800000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// L'ARBITRE DES COULEURS
if (this.estConnecte == false) {
    voyant_rect.setFillColor(gray);   // Gris : Déconnecté
} else if (this.stake >= 32.0) {
    voyant_rect.setFillColor(cyan); // cyan : Validateur
} else {
    voyant_rect.setFillColor(black);  // Noir : Nœud normal
    indexText.setColor(white);
    chainLengthText.setColor(white);
}]]></Action>
				</Event>
				<Event>
					<Id>1769265750231</Id>
					<Name><![CDATA[RadarConnexion]]></Name>
					<X>-100</X><Y>150</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_SECOND]]></Unit>
						</Rate>
						<Id>1769265750229</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1769328000000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[2]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// 1. SI JE SUIS ÉTEINT, JE DORS
if (this.estConnecte == false) return;

// 2. SI JE SUIS DÉJÀ BIEN ENTOURÉ, JE NE FAIS RIEN
if (this.getConnections().size() >= 3) return;

// 3. JE CHERCHE ACTIVEMENT
Main mainAgent = (Main) getOwner();
List<noeud> candidats = new ArrayList<noeud>();

for (noeud n : mainAgent.noeuds) {
    candidats.add(n);
}
Collections.shuffle(candidats); 

boolean aTrouve = false;

for (noeud candidat : candidats) {
    if (this.getConnections().size() >= 3) break;

    if (candidat != this && 
        candidat.estConnecte == true && 
        !this.isConnectedTo(candidat) &&
        candidat.getConnections().size() < 3) {
        
        connectTo(candidat);
        aTrouve = true;
    }
}

// 4. SYNCHRONISATION APRÈS RECONNEXION
if (aTrouve) {
    noeud meilleurVoisin = null;
    int meilleurHauteur = this.blockchain.size();

    for (Agent a : getConnections()) {
        if (a instanceof noeud) {
            noeud voisin = (noeud)a;
            if (voisin.estConnecte && voisin.blockchain.size() > meilleurHauteur) {
                meilleurHauteur = voisin.blockchain.size();
                meilleurVoisin = voisin;
            }
        }
    }

    if (meilleurVoisin != null) {
        traceln("🔄 SYNC: Alignement sur Noeud " + meilleurVoisin.getIndex());
        this.blockchain = new ArrayList<Block>(meilleurVoisin.blockchain);
        chainLengthText.setText("Blocks: " + this.blockchain.size());
        
        voyant_rect.setFillColor(magenta);
        revertColorEvent.restart(0.1);
        
    }
}]]></Action>
				</Event>
			</Events>

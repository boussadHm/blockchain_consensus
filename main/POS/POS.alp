				<Control Type="Button">
				 	<EmbeddedIcon>false</EmbeddedIcon>				
					<Id>1768140845229</Id>
					<Name><![CDATA[Export_Data]]></Name>
					<X>-250</X><Y>150</Y>
					<Label><X>0</X><Y>-10</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D3D</DrawMode>
					<BasicProperties Width="100" Height="30">
                        <EmbeddedIcon>false</EmbeddedIcon>	
						<TextColor>-16777216</TextColor>
						<Enabled>true</Enabled>
						<ActionCode><![CDATA[try {
    java.io.File projectDir = new java.io.File(System.getProperty("user.dir"));
    java.io.File parent = projectDir.getParentFile().getParentFile().getParentFile();
    
    java.io.File outputDir = new java.io.File(parent+"/comparaison/pos");
    if (!outputDir.exists()) outputDir.mkdirs();
    
    java.io.File file = new java.io.File(outputDir,
        "POS_run" + runID + "_stk" + p_tauxStaking + 
        "_pp" + p_probaPanne + ".dat");
    
    traceln("📁 Export : " + file.getAbsolutePath());

    java.io.PrintStream ps = new java.io.PrintStream(
        new java.io.FileOutputStream(file));

    // EN-TÊTE
    ps.println("# === RUN PoS ===");
    ps.println("# Taux_staking : " + p_tauxStaking);
    ps.println("# Proba_panne : " + p_probaPanne);
    ps.println("# Temps_simulation : " + 
        String.format(java.util.Locale.US, "%.1f", time()));
    ps.println("#");
    ps.println("# NodeID  Balance  Stake  RecompensesTotales  NbBlocs  EstConnecte");

    // DONNÉES PAR NŒUD + calcul des stats en même temps
    int nbValidateurs = 0;
    double totalStake = 0;
    double maxRecompense = 0;
    double minRecompense = Double.MAX_VALUE;
    int maxBlocs = 0;
    int minBlocs = Integer.MAX_VALUE;
    int nbConnectes = 0;

    for (noeud n : noeuds) {
        // Ligne de données
        ps.println(
            n.getIndex() + " " +
            String.format(java.util.Locale.US, "%.3f", n.balance) + " " +
            String.format(java.util.Locale.US, "%.1f", n.stake) + " " +
            String.format(java.util.Locale.US, "%.3f", n.recompensesTotales) + " " +
            n.blockchain.size() + " " +
            (n.estConnecte ? 1 : 0)
        );

        // Calcul des stats
        if (n.stake >= 32.0) nbValidateurs++;
        if (n.estConnecte) nbConnectes++;
        totalStake += n.stake;
        if (n.recompensesTotales > maxRecompense) maxRecompense = n.recompensesTotales;
        if (n.recompensesTotales < minRecompense && n.estConnecte) 
            minRecompense = n.recompensesTotales;
        if (n.blockchain.size() > maxBlocs) maxBlocs = n.blockchain.size();
        if (n.blockchain.size() < minBlocs) minBlocs = n.blockchain.size();
    }

    double ecartRecompenses = maxRecompense - minRecompense;

    // STATS GLOBALES
    ps.println("");
    ps.println("# === STATS GLOBALES ===");
    ps.println("# Nb_validateurs : " + nbValidateurs);
    ps.println("# Nb_connectes : " + nbConnectes);
    ps.println("# Total_stake_ETH : " + 
        String.format(java.util.Locale.US, "%.1f", totalStake));
    ps.println("# Ecart_recompenses : " + 
        String.format(java.util.Locale.US, "%.3f", ecartRecompenses));
    ps.println("# Hauteur_chaine_max : " + maxBlocs);
    ps.println("# Hauteur_chaine_min : " + minBlocs);
    ps.println("# Ecart_chaines : " + (maxBlocs - minBlocs));
    ps.println("# Blocs_par_seconde : " +
        String.format(java.util.Locale.US, "%.4f", (double)maxBlocs / time()));

    ps.close();
    traceln("✅ Export réussi : " + file.getName());

} catch (Exception e) {
    traceln("❌ ERREUR : " + e.getMessage());
}]]></ActionCode>

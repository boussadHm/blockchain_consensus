	<JavaClasses>
		<!--   =========   Java Class   ========  -->
		<JavaClass>
			<Id>1762374406332</Id>
			<Name><![CDATA[Block]]></Name>
			<Text><![CDATA[//Importe les bibliothèques Java nécessaires
import java.security.MessageDigest;
import java.util.Date;

public class Block {

 // --- 1. Variables Statiques (pour la difficulté) ---
 public static int difficulty = 3; // Ajustez ici pour plus de difficulté
 public static String difficultyTarget = new String(new char[difficulty]).replace('\0', '0');

 
 // --- 2. Variables d'Instance (les données du bloc) ---
 public String hash;
 public String previousHash;
 public String transactions;
 public long timestamp;
 public int nonce;

 
 // --- 3. Le Constructeur ---
 public Block(String transactions, String previousHash) {
     this.transactions = transactions;
     this.previousHash = previousHash;
     this.timestamp = new Date().getTime();
     this.nonce = 0;
     this.hash = calculateHash();
 }

 
 // --- 4. La Fonction de Hachage ---
 public String calculateHash() {
     try {
         String dataToHash = previousHash +
                             Long.toString(timestamp) +
                             Integer.toString(nonce) +
                             transactions;
         
         MessageDigest digest = MessageDigest.getInstance("SHA-256");
         byte[] hashBytes = digest.digest(dataToHash.getBytes("UTF-8"));
         
         StringBuffer hexString = new StringBuffer();
         for (int i = 0; i < hashBytes.length; i++) {
             String hex = Integer.toHexString(0xff & hashBytes[i]);
             if (hex.length() == 1) hexString.append('0');
             hexString.append(hex);
         }
         return hexString.toString();
         
     } catch (Exception e) {
         throw new RuntimeException(e);
     }
 }


 
 
}]]></Text>
		</JavaClass>
	</JavaClasses>

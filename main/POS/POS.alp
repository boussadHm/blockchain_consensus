		<!--   =========   Active Object Class   ========  -->
		<ActiveObjectClass>
			<Id>1762075494712</Id>
			<Name><![CDATA[noeud]]></Name>
			<Import><![CDATA[import com.anylogic.engine.TimeUnits;]]></Import>
			<StartupCode><![CDATA[if (randomTrue(main.p_tauxStaking)){ 
    // VALIDATEUR
    this.balance = uniform(50.0, 150.0);
    this.stake = 32.0;    
    voyant_rect.setFillColor(cyan); 
    indexText.setColor(black);
    chainLengthText.setColor(black);
    
} else {
    // NŒUD NORMAL
    this.balance = uniform(0.1, 15.0); 
    this.stake = 0; 
    voyant_rect.setFillColor(black);
}]]></StartupCode>
			<Generic>false</Generic>
			<GenericParameter>
				<Id>1762075494717</Id>
				<Name><![CDATA[1762075494717]]></Name>
				<GenericParameterValue Class="CodeValue">
					<Code><![CDATA[T extends Agent]]></Code>
				</GenericParameterValue>
				<GenericParameterLabel><![CDATA[Generic parameter:]]></GenericParameterLabel>
			</GenericParameter>
			<FlowChartsUsage>ENTITY</FlowChartsUsage>
			<SamplesToKeep>100</SamplesToKeep>
			<LimitNumberOfArrayElements>false</LimitNumberOfArrayElements>
			<ElementsLimitValue>100</ElementsLimitValue>
			<MakeDefaultViewArea>true</MakeDefaultViewArea>
			<SceneGridColor/>
			<SceneBackgroundColor>-4144960</SceneBackgroundColor>
            <EnvironmentResourceRef></EnvironmentResourceRef>
            <EnvironmentType>NONE</EnvironmentType>
            <EnvironmentRotationX>0</EnvironmentRotationX>
            <EnvironmentRotationY>0</EnvironmentRotationY>
            <EnvironmentRotationZ>0</EnvironmentRotationZ>
            <EnvironmentIntensity>1</EnvironmentIntensity>
			<AgentProperties>
				<EnvironmentDefinesInitialLocation>true</EnvironmentDefinesInitialLocation>
				<RotateAnimationTowardsMovement>true</RotateAnimationTowardsMovement>
				<RotateAnimationVertically>false</RotateAnimationVertically>
				<VelocityCode Class="CodeUnitValue">
					<Code><![CDATA[10]]></Code>
					<Unit Class="SpeedUnits"><![CDATA[MPS]]></Unit>
				</VelocityCode>
				<MessageType><![CDATA[Object]]></MessageType>
				<OnReceive><![CDATA[// Si le nœud est hors ligne, il fait le mort (il ne reçoit rien, il ne propage rien)
if (this.estConnecte == false) {
    return;
}

if (msg instanceof Block) {
    Block receivedBlock = (Block) msg;

    // --- 1. PROTECTION ANTI-BOUCLE ---
    for (Block b : blockchain) {
        if (b.hash.equals(receivedBlock.hash)) return; 
    }

    // --- 2. IDENTIFICATION SÉCURISÉE (On lit l'enveloppe) ---
    noeud vraiExpediteur;
    if (sender instanceof Messager) {
        vraiExpediteur = ((Messager)sender).expediteur;
    } else {
        vraiExpediteur = (noeud) sender;
    }

    // --- 3. VALIDATION DU BLOC ---
    boolean isValid = receivedBlock.calculateHash().equals(receivedBlock.hash); 
    
    String monTitre = (this.stake >= 32.0) ? "Validateur " : "Nœud ";
    String titreExpediteur = (vraiExpediteur.stake >= 32.0) ? "Validateur " : "Nœud ";
    
    if (!isValid) {
        traceln("🚨 " + monTitre + getIndex() + " : Bloc INVALIDE reçu de " + vraiExpediteur.getIndex() + ". Rejeté.");
        voyant_rect.setFillColor(red); 
        revertColorEvent.restart(1.0, SECOND);
        return;
    }
    
    // --- 4. INTÉGRATION ET SYNCHRONISATION ---
    String myLastHash = "0";
    if (!this.blockchain.isEmpty()) {
        myLastHash = this.blockchain.get(this.blockchain.size() - 1).hash;
    }
    
    // CAS A : Continuité parfaite
    if (this.blockchain.isEmpty() || receivedBlock.previousHash.equals(myLastHash)) {
        this.blockchain.add(receivedBlock);
        
        traceln(monTitre + this.getIndex() + " a accepté le Bloc " + (this.blockchain.size() - 1) + " de la part du " + titreExpediteur + vraiExpediteur.getIndex());        
        updateVisuals();
        
        voyant_rect.setFillColor(blue);
        revertColorEvent.restart(1.0, SECOND);

        // La vague continue !
        for (Agent voisin : getConnections()) {
            if (voisin != vraiExpediteur) { // On ne renvoie pas à celui qui vient de nous l'apporter
                if (main.chk_simulerFork.isSelected()) {
                    create_SendWithDelayEvent(uniform(0.5, 3.0), SECOND, receivedBlock, voisin);
                } else {
                    Messager m = main.add_messagers();
                    m.setXY(this.getX(), this.getY());
                    m.cible = (noeud) voisin;
                    m.blocTransporte = receivedBlock;
                    m.expediteur = this;
                    m.moveTo(voisin.getX(), voisin.getY());
                }
            }
        }
    
    // CAS B : Résolution de Fork
    } else if (vraiExpediteur.blockchain.size() > this.blockchain.size()) {
        traceln("🔄 " + monTitre + this.getIndex() + " se synchronise sur " + vraiExpediteur.getIndex());
        this.blockchain = new ArrayList<Block>(vraiExpediteur.blockchain);
        updateVisuals();
        
        voyant_rect.setFillColor(blue);
        revertColorEvent.restart(1.0, SECOND);

        // La vague de correction continue !
        for (Agent voisin : getConnections()) {
            if (voisin != vraiExpediteur) {
                if (main.chk_simulerFork.isSelected()) {
                    create_SendWithDelayEvent(uniform(0.5, 3.0), SECOND, receivedBlock, voisin);
                } else {
                    Messager m = main.add_messagers();
                    m.setXY(this.getX(), this.getY());
                    m.cible = (noeud) voisin;
                    m.blocTransporte = receivedBlock;
                    m.expediteur = this;
                    m.moveTo(voisin.getX(), voisin.getY());
                }
            }
        }
    }
}]]></OnReceive>

			<Events>
				<Event>
					<Id>1773749463353</Id>
					<Name><![CDATA[Horloge_Slots]]></Name>
					<X>-240</X><Y>270</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_SECOND]]></Unit>
						</Rate>
						<Id>1773749463351</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1773820800000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[12]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[12]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[traceln("===============================================");
traceln("⏱️ NOUVEAU SLOT DÉMARRÉ");

// =========================================================
// 0. ÉVOLUTION DU RÉSEAU : L'ÉQUILIBRE (Staking & Exit)
// =========================================================
for (noeud n : this.noeuds) {
    if (n.estConnecte == true) { 
        
        // CAS A : Un nœud passif décide d'investir (Staking)
        if (n.stake < 32.0) {
            // 2% de chance de devenir validateur
            if (randomTrue(0.02)) { 
                n.stake = 32.0; 
                n.revertColorEvent.restart(0.01, SECOND); 
                traceln("🎉 IN : Le Nœud " + n.getIndex() + " verrouille 32 ETH et devient Validateur !");
            }
        }
        // CAS B : Un validateur décide de retirer son argent (Voluntary Exit)
        else if (n.stake == 32.0) {
            // 1% de chance de quitter le consensus
            if (randomTrue(0.02)) {
                n.stake = 0.0; // Il récupère son argent
               n.revertColorEvent.restart(0.01, SECOND); 
                traceln("👋 OUT : Le Validateur " + n.getIndex() + " retire ses fonds et redevient passif.");
            }
        }
        
    }
}

// =========================================================
// 1. Rassembler tous les validateurs éligibles
// =========================================================
List<noeud> validateursActifs = new ArrayList<noeud>();

for (noeud n : this.noeuds) {
    if (n.estConnecte == true && n.stake == 32.0) { 
        validateursActifs.add(n);
    }
}

// 2. Vérification de survie
if (validateursActifs.isEmpty()) {
    traceln("⚠️ MISSED SLOT : Aucun validateur actif en ligne.");
    return;
}

traceln("📊 " + validateursActifs.size() + " validateurs en compétition équitable.");

// =========================================================
// 3. LA SÉLECTION SIMPLIFIÉE (Tirage Uniforme)
// =========================================================
int indexGagnant = uniform_discr(0, validateursActifs.size() - 1);
noeud gagnant = validateursActifs.get(indexGagnant);

// =========================================================
// 4. L'ACTION DU GAGNANT
// =========================================================
traceln("👑 Le Validateur " + gagnant.getIndex() + " est sélectionné pour forger le bloc !");
gagnant.effectuerMinage();]]></Action>
				</Event>
				<Event>
					<Id>1773847571923</Id>
					<Name><![CDATA[evt_Instabilite]]></Name>
					<X>-240</X><Y>40</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_SECOND]]></Unit>
						</Rate>
						<Id>1773847571921</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1773907200000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[30]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[30]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// Toutes les minutes, on passe en revue tous les nœuds
for (noeud n : noeuds) {
    
    if (n.estConnecte) {
        // S'il est connecté : 5% de malchance de subir une coupure totale
        if (randomTrue(p_probaPanne)) {
            n.estConnecte = false;
            
            // 1. On note les voisins dans le carnet d'adresses avant de couper
            n.voisinsSauvegardes.clear();
            for (Agent voisin : n.getConnections()) {
                n.voisinsSauvegardes.add((noeud) voisin);
            }
            
            // 2. On DÉTRUIT toutes les connexions (les lignes visuelles disparaissent)
			n.disconnectFromAll();            
            
            // 3. Le nœud devient complètement GRIS
            n.voyant_rect.setFillColor(gray); 
            
            String titre = (n.stake >= 32.0) ? "Validateur " : "Nœud ";
            traceln("❌ COUPURE : Le " + titre + n.getIndex() + " est totalement isolé de la toile !");
        }
    } 
    else {
        // S'il est isolé : 50% de chance que le réseau soit rétabli
        if (randomTrue(0.50)) {
            n.estConnecte = true;
            
            // 1. On rebranche les câbles avec tous les anciens voisins du carnet
            for (noeud ancienVoisin : n.voisinsSauvegardes) {
                n.connectTo(ancienVoisin);
            }
            n.voisinsSauvegardes.clear(); // On vide le carnet
            
            // 2. On lui rend sa VRAIE identité visuelle
            if (n.stake >= 32.0) {
                n.voyant_rect.setFillColor(cyan); 
            } else {
                n.voyant_rect.setFillColor(black); 
            }
            
            String titre = (n.stake >= 32.0) ? "Validateur " : "Nœud ";
            traceln("🔌 RETOUR : Le " + titre + n.getIndex() + " a rebranché ses connexions !");
        }
    }
}]]></Action>
				</Event>
			</Events>


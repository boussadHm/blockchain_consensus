                        <EmbeddedIcon>false</EmbeddedIcon>	
						<TextColor>-16777216</TextColor>
						<Enabled>true</Enabled>
						<ActionCode><![CDATA[try {

    java.io.File projectDir = new java.io.File(System.getProperty("user.dir"));
	java.io.File parent = projectDir.getParentFile();
	
	java.io.File file = new java.io.File(parent+"/comparaison/pow",
	 		"POW_run" + runID + "_dif"+blockchain2.Block.difficulty + 
	 		"_n" + noeuds.size() + ".dat");
	
    traceln("📁 Export : " + file.getAbsolutePath());

    java.io.PrintStream ps = new java.io.PrintStream(
        new java.io.FileOutputStream(file));

    // EN-TÊTE avec les paramètres du run
    ps.println("# === RUN PoW ===");
    ps.println("# Difficulte : " + blockchain2.Block.difficulty);
    ps.println("# Nb_noeuds : " + noeuds.size());
    ps.println("# Recompense_bloc : " + noeuds.get(0).BLOCK_REWARD);
    ps.println("# Fork_active : " + chk_simulerFork.isSelected());
    ps.println("# Temps_simulation : " + 
        String.format(java.util.Locale.US, "%.1f", time()));
    ps.println("#");
    ps.println("# NodeID  Balance  NbBlocs  EstConnecte  EnTrainDeMiner");

    // DONNÉES PAR NŒUD
    for (noeud n : noeuds) {
        ps.println(
            n.getIndex() + " " +
            String.format(java.util.Locale.US, "%.3f", n.balance) + " " +
            n.blockchain.size() + " " +
            (n.estConnecte ? 1 : 0) + " " +
            (n.blockInProgress != null ? 1 : 0)
        );
    }

    // STATS GLOBALES
    int nbConnectes = 0;
    double totalRecompenses = 0;
    int maxBlocs = 0;
    int minBlocs = Integer.MAX_VALUE;
    noeud meilleurMineur = null;

    for (noeud n : noeuds) {
        if (n.estConnecte) nbConnectes++;
        totalRecompenses += n.balance;
        if (n.blockchain.size() > maxBlocs) {
            maxBlocs = n.blockchain.size();
            meilleurMineur = n;
        }
        if (n.blockchain.size() < minBlocs) minBlocs = n.blockchain.size();
    }

    ps.println("#");
    ps.println("# === STATS GLOBALES ===");
    ps.println("# Nb_connectes : " + nbConnectes);
    ps.println("# Total_BTC_distribues : " +
        String.format(java.util.Locale.US, "%.3f", totalRecompenses));
    ps.println("# Hauteur_chaine_max : " + maxBlocs);
    ps.println("# Hauteur_chaine_min : " + minBlocs);
    ps.println("# Ecart_chaines : " + (maxBlocs - minBlocs));
    ps.println("# Blocs_par_seconde : " +
        String.format(java.util.Locale.US, "%.4f", (double)maxBlocs / time()));
    ps.println("# Meilleur_mineur : " + 
        (meilleurMineur != null ? meilleurMineur.getIndex() : "N/A"));
	ps.println("# Nb_forks : " + nbForks);
	ps.println("# Nb_rejets : " + nbRejets);
    ps.close();
    traceln("✅ Export réussi : " + file.getName());

} catch (Exception e) {
    traceln("❌ ERREUR : " + e.getMessage());
}]]></ActionCode>

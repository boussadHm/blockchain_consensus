			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1762423990070</Id>
					<Name><![CDATA[updateVisuals]]></Name>
					<X>-100</X><Y>80</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[/**
 * Met à jour l'interface visuelle du nœud.
 * Cette fonction permet de visualiser l'état actuel de la chaîne locale.
 */

// 1. Récupération de la taille de la blockchain
// On compte le nombre de blocs validés dans notre liste locale.
int chainSize = blockchain.size();

// 2. Mise à jour de l'affichage
// On modifie le texte sur l'agent pour montrer la hauteur de la chaîne (Block Height).
chainLengthText.setText("Blocks: " + chainSize);

// String.format("%.3f", ...) permet d'afficher juste 3 chiffres après la virgule (ex: 6.250)
    rewardText.setText(String.format("%.3f BTC", balance));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1762429187324</Id>
					<Name><![CDATA[flash]]></Name>
					<X>-100</X><Y>50</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[colorToFlash]]></Name>
						<Type><![CDATA[Color]]></Type>
					</Parameter>
					<Body><![CDATA[/**
 * Déclenche un feedback visuel temporaire (Flash) sur l'interface du nœud.
 * Cette fonction permet de visualiser instantanément l'état du consensus :
 * - Vert : Bloc miné avec succès.
 * - Bleu : Bloc valide accepté.
 * - Orange : Bloc invalide rejeté (Fraude).
 * - Jaune : Changement de chaîne (Fork).
 */

// 1. Mise à jour immédiate de l'interface
// On applique la couleur demandée (colorToFlash) au rectangle indicateur.
voyant_rect.setFillColor(colorToFlash);

// 2. Planification de la réinitialisation
// On démarre (ou redémarre) le minuteur qui éteindra le voyant (retour au gris)
// après un délai fixe de 1 seconde.
revertColorEvent.restart(1, SECOND);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1763844291162</Id>
					<Name><![CDATA[propagerVisuel]]></Name>
					<X>-100</X><Y>20</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[provenance]]></Name>
						<Type><![CDATA[noeud]]></Type>
					</Parameter>
					<Body><![CDATA[// Fonction: propagerVisuel(noeud provenance)

// --- 1. LA PROTECTION ABSOLUE ---
// Si j'ai déjà reçu ce visuel (par n'importe quel voisin), j'arrête TOUT ici.
// Le message meurt ici et ne sera pas propagé plus loin.
if (visuelDejaRecu == true) {
    return; 
}

// --- 2. MARQUAGE ---
// Je marque que je l'ai vu, pour ne plus jamais le traiter dans cette vague
visuelDejaRecu = true;

// Je programme le "nettoyage" de ma mémoire dans 5 secondes (pour la prochaine vague)
create_EventResetVisuel(5, SECOND);



// --- 3. LE RELAIS SÉCURISÉ ---
for (Agent a : getConnections()) {
    noeud voisin = (noeud) a;
    
    // Règle de base : Ne pas renvoyer immédiatement en arrière
    // (Même si 'visuelDejaRecu' protège déjà le voisin, c'est plus propre de ne pas envoyer)
    if (voisin != provenance) {
        
        Messager leMessager = main.add_messagers(voisin, this);
        leMessager.jumpTo(this.getX(), this.getY());
        
       
        
        leMessager.setSpeed(150); 
        leMessager.moveTo(voisin);
    }
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1768502130627</Id>
					<Name><![CDATA[gestionReseau]]></Name>
					<X>-100</X><Y>440</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[activer]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Body><![CDATA[if (activer == false) {
    // =========================================================
    // CAS 1 : DÉCONNEXION (OFF)
    // =========================================================
    if (this.estConnecte == false) return;

    // 1. On coupe les ponts
    disconnectFromAll();
    
    // 2. Apparence OFF
    try { revertColorEvent.reset(); } catch(Exception e) {}
    voyant_rect.setFillColor(silver); 
    
    this.estConnecte = false;
    traceln("❌ Noeud " + this.getIndex() + " déconnecté.");

} else {
    // =========================================================
    // CAS 2 : RECONNEXION ALÉATOIRE (ON)
    // =========================================================
    if (this.estConnecte == true) return;

    // 1. ACCÈS AU MENU PRINCIPAL
    Main mainAgent = (Main) getOwner();
    
    // 2. LISTE DES CANDIDATS (Correction ici : Copie Manuelle) 🛠️
    List<noeud> candidats = new ArrayList<noeud>();
    
    // On parcourt la population et on remplit notre liste temporaire
    for (noeud n : mainAgent.noeuds) {
        candidats.add(n);
    }
    
    // Maintenant on peut mélanger !
    Collections.shuffle(candidats); 
    
    int mesConnexions = 0;

    for (noeud candidat : candidats) {
        // STOP si j'ai déjà mes 3 amis
        if (mesConnexions >= 3) break;

        // CRITÈRES DE SÉLECTION :
        // A. Pas moi-même
        // B. Le candidat est vivant (connecté)
        // C. Le candidat a de la place (moins de 3 voisins)
        if (candidat != this && 
            candidat.estConnecte == true && 
            candidat.getConnections().size() < 3) {
            
            connectTo(candidat);
            mesConnexions++;
        }
    }
    
    // 3. RETOUR VISUEL
    voyant_rect.setFillColor(black);
    
    this.estConnecte = true;
    traceln("✅ Noeud " + this.getIndex() + " connecté (" + mesConnexions + " nouveaux voisins).");

    // 4. SYNCHRONISATION
    noeud meilleurVoisin = null;
    int meilleurHauteur = this.blockchain.size();

    for (Agent a : getConnections()) {
        if (a instanceof noeud) {
            noeud voisin = (noeud)a;
            if (voisin.estConnecte && voisin.blockchain.size() > meilleurHauteur) {
                meilleurHauteur = voisin.blockchain.size();
                meilleurVoisin = voisin;
            }
        }
    }

    if (meilleurVoisin != null) {
        traceln("🔄 SYNC : Noeud " + this.getIndex() + " <- Noeud " + meilleurVoisin.getIndex());
        this.blockchain = new ArrayList<Block>(meilleurVoisin.blockchain); // J'ai ajouté <Block> pour être sûr
        chainLengthText.setText("Blocks: " + this.blockchain.size());
        
        voyant_rect.setFillColor(magenta);
        
        // On déclenche le retour à la normale dans 0.1 seconde (très vite !)
        // Au lieu d'attendre 1 seconde par défaut.
        revertColorEvent.restart(0.5);
    } 

    // 5. RESET MOTEUR
    Nonce.setText("0"); 
    this.currentNonce = 0; 

    if (this.blockInProgress != null) {
        this.blockInProgress.nonce = 0;
        this.blockInProgress.hash = null; 
    }
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1768513474134</Id>
					<Name><![CDATA[effectuerMinage]]></Name>
					<X>-100</X><Y>470</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// 1. SÉCURITÉ
if (this.estConnecte == false) return;

// 2. AUTO-RÉPARATION (Si le bloc est vide, on le crée)
if (this.blockInProgress == null && !this.blockchain.isEmpty()) {
    Block lastBlock = this.blockchain.get(this.blockchain.size() - 1);
    this.blockInProgress = new Block("Transactions du bloc " + (this.blockchain.size()), lastBlock.hash);
    this.blockInProgress.nonce = 0;
    this.currentNonce = 0;
}

if (this.blockInProgress == null) return;

// 3. MINAGE (Incrémentation & Affichage)
this.currentNonce++; 
this.blockInProgress.nonce = this.currentNonce;
Nonce.setText("" + this.currentNonce); 

// 4. VERIFICATION DU HASH
String hashTrouve = this.blockInProgress.mineBlock(this.currentNonce);

// 5. EN CAS DE SUCCÈS
if (hashTrouve != null) {
    // On garde ce log car c'est une info utile pour suivre la simulation
    traceln("⛏️ Noeud " + this.getIndex() + " a MINÉ le bloc " + this.blockchain.size());
    
    this.blockInProgress.hash = hashTrouve;
    this.blockchain.add(this.blockInProgress);
    
    this.balance =     this.balance + BLOCK_REWARD;
    
    // Mise à jour interface
    chainLengthText.setText("Blocks: " + this.blockchain.size());
    laptop_open_off.setColor("MA_black", lime);
    
    // Propagation aux voisins
    sendToAllConnected(this.blockInProgress);
    
    // Reset pour le prochain tour
    this.blockInProgress = null; 
    this.currentNonce = 0;
    Nonce.setText("0");
}]]></Body>
				</Function>
			</Functions>


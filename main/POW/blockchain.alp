					<Properties Source="1762424258181" Target="1762424258181" Trigger="timeout">
						<Action><![CDATA[if (this.estConnecte == false) return;
/**
 * LOGIQUE DE MINAGE (Boucle)
 * Cette action est exécutée à chaque "tick" du timer (0.01s).
 * Elle tente de trouver une preuve de travail (nonce) pour le bloc en cours.
 */

// 1. PRÉPARATION : Si aucun bloc n'est en cours, on en crée un nouveau
if (blockInProgress == null) {
    // On se base sur le dernier bloc de la chaîne locale
    Block lastBlock = blockchain.get(blockchain.size() - 1);
    blockInProgress = new Block("Transactions du bloc " + (blockchain.size()), lastBlock.hash);
    currentNonce = 0; // Réinitialiser le compteur de tentatives
}

// 2. TRAVAIL : Tentative unique de minage (Non-bloquant)
String winningHash = blockInProgress.mineBlock(currentNonce); // On appelle mineBlock

// 3. VÉRIFICATION : A-t-on trouvé le bon hash ?
if (winningHash != null) {
    
    // --- SUCCÈS (Proof-of-Work trouvé) ---
    traceln("Noeud " + getIndex() + ": J'AI MINÉ LE BLOC " + blockchain.size() + " !");
    
    flash(Color.GREEN); // Feedback visuel
    
    // b. Ajout à la chaîne locale
    blockchain.add(blockInProgress);
    
    // Protection visuelle (pour ne pas réagir à sa propre diffusion)
    visuelDejaRecu = true; 
    create_EventResetVisuel(5, SECOND);
    
    
    // c. DIFFUSION (Gossip Protocol)
    // Le comportement dépend du mode choisi (Latence ou Instantané)
    if (main.chk_simulerFork.isSelected()) {
        // CAS 1 : RÉSEAU RÉALISTE (Latence activée)
        for (Agent a : getConnections()) {
            noeud voisin = (noeud) a;
                
            // 1. Création du facteur visuel (Cible, Source)
            Messager leMessager = main.add_messagers(voisin, this);
            
            // 2. Placement & Vitesse lente
            leMessager.jumpTo(this.getX(), this.getY());
            leMessager.setSpeed(150); 
            
            // 3. Départ
            leMessager.moveTo(voisin);

            // Logique : Envoi avec délai aléatoire
            double delaiAleatoire = uniform(1.0, 2.0);
            create_SendWithDelayEvent(
                delaiAleatoire,      // délai
                SECOND,              // unité
                blockInProgress,     // paramètre message
                a                    // paramètre destinataire
            );
        }
    } else {
        // CAS 2 : RÉSEAU PARFAIT (Instantané)
        for (Agent a : getConnections()) {
            noeud voisin = (noeud) a;
            
            // 1. Création du facteur visuel
            Messager leMessager = main.add_messagers(voisin, this);
            
            // 2. Placement & Vitesse rapide
            leMessager.jumpTo(this.getX(), this.getY());
            leMessager.setSpeed(150); 
            
            // 3. Départ
            leMessager.moveTo(voisin);
            
            // Logique : Envoi immédiat
            send(blockInProgress, a); 
        }
    }
    
    // $$$ ON ENCAISSE LA RÉCOMPENSE $$$
    balance = balance + BLOCK_REWARD;
    
    // d. Mise à jour de l'interface
    updateVisuals();
    
    // e. Réinitialisation pour le prochain bloc
    blockInProgress = null;
    currentNonce = 0;

} else {
    // --- ÉCHEC (Nonce invalide) ---
    // On incrémente le compteur pour tester le nonce suivant au prochain tick
    currentNonce++;
}]]></Action>

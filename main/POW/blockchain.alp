					<Action><![CDATA[// 1. SI JE SUIS ÉTEINT, JE DORS
if (this.estConnecte == false) return;

// 2. SI JE SUIS DÉJÀ BIEN ENTOURÉ, JE NE FAIS RIEN
// (Dans Bitcoin réel, c'est 8, ici on garde la règle de 3)
if (this.getConnections().size() >= 3) return;

// 3. JE CHERCHE ACTIVEMENT (RETRY LOGIC)
Main mainAgent = (Main) getOwner();
List<noeud> candidats = new ArrayList<noeud>();

// On liste tout le monde
for (noeud n : mainAgent.noeuds) {
    candidats.add(n);
}
Collections.shuffle(candidats); // On mélange pour tester au hasard

boolean aTrouve = false;

for (noeud candidat : candidats) {
    // Si je suis plein, j'arrête
    if (this.getConnections().size() >= 3) break;

    // CRITÈRES : Pas moi, Pas déjà ami, Est allumé, A de la place
    if (candidat != this && 
        candidat.estConnecte == true && 
        !this.isConnectedTo(candidat) &&
        candidat.getConnections().size() < 3) {
        
        connectTo(candidat);
        aTrouve = true;
        // On ne met pas de Trace ici pour ne pas spammer la console,
        // sauf si vous voulez voir "Nouveau voisin trouvé !"
    }
}

// 4. SI J'AI TROUVÉ UN AMI APRÈS AVOIR ÉTÉ SEUL
// Je dois vérifier s'il a une meilleure chaîne que moi (Synchro retardée)
if (aTrouve) {
    noeud meilleurVoisin = null;
    int meilleurHauteur = this.blockchain.size();

    for (Agent a : getConnections()) {
        if (a instanceof noeud) {
            noeud voisin = (noeud)a;
            if (voisin.estConnecte && voisin.blockchain.size() > meilleurHauteur) {
                meilleurHauteur = voisin.blockchain.size();
                meilleurVoisin = voisin;
            }
        }
    }

    if (meilleurVoisin != null) {
        traceln("🔄 SYNC (Radar) : Alignement sur Noeud " + meilleurVoisin.getIndex());
        this.blockchain = new ArrayList<Block>(meilleurVoisin.blockchain);
        chainLengthText.setText("Blocks: " + this.blockchain.size());
        
        // Petit flash violet discret
        voyant_rect.setFillColor(magenta);
        revertColorEvent.restart(0.1);
        
        // Reset minage
        this.blockInProgress = null;
        Nonce.setText("0");
    }
}]]></Action>
				</Event>

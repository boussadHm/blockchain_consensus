		<!--   =========   Active Object Class   ========  -->
		<ActiveObjectClass>
			<Id>1762075315668</Id>
			<Name><![CDATA[Main]]></Name>
			<StartupCode><![CDATA[traceln("⚙️ nbNoeuds : " + noeuds.size() + 
        " | mandant leader: " + p_mandatLeader +
        " | proba panne : " + p_probaPanne);
client.setXY(1000, 50);
// ==========================================
// 1. DISPOSITION EN ELLIPSE (Plein Écran)
// ==========================================
// On sépare le rayon en deux pour faire un ovale adapté à un écran rectangulaire
double rayonX = 450.0; // Étirement horizontal (gauche-droite)
double rayonY = 250.0; // Étirement vertical (haut-bas)

// On décale le centre vers le milieu de la page blanche
double centreX = 550.0; 
double centreY = 350.0;

for (int i = 0; i < this.noeuds.size(); i++) {
    noeud n = this.noeuds.get(i);
    // Calcul de l'angle pour répartir les 10 nœuds équitablement
    double angle = i * 2 * Math.PI / this.noeuds.size();
    
    // Application de la formule de l'ellipse
    n.setXY(centreX + rayonX * Math.cos(angle), centreY + rayonY * Math.sin(angle));
}


// ==========================================
// 2. FORCER LE FULL MESH INSTANTANÉ
// ==========================================
for (noeud n1 : this.noeuds) {
    for (noeud n2 : this.noeuds) {
        // Si ce n'est pas le même nœud et qu'ils ne sont pas déjà connectés
        if (n1 != n2 && !n1.isConnectedTo(n2)) {
            n1.connectTo(n2);
        }
    }
}

// ==========================================
// 3. COURONNEMENT IMMÉDIAT DU PREMIER LEADER
// ==========================================
this.noeuds.get(0).estLeader = true;]]></StartupCode>

				<Control Type="Button">
				 	<EmbeddedIcon>false</EmbeddedIcon>				
					<Id>1768140845229</Id>
					<Name><![CDATA[Export_Data]]></Name>
					<X>-250</X><Y>110</Y>
					<Label><X>0</X><Y>-10</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D3D</DrawMode>
					<BasicProperties Width="100" Height="30">
                        <EmbeddedIcon>false</EmbeddedIcon>	
						<TextColor>-16777216</TextColor>
						<Enabled>true</Enabled>
						<ActionCode><![CDATA[try {
   // 1. DÉTECTION AUTOMATIQUE 
 
	java.io.File projectDir = new java.io.File(System.getProperty("user.dir"));

	java.io.File parent = projectDir.getParentFile();
	
	java.io.File file = new java.io.File(parent+"/comparaison/pbft",
	 		"PBFT_run" + runID + 
	 		"_pp"+p_probaPanne+
	 		"_mandat" + p_mandatLeader +
	 		"_n" + noeuds.size() + ".dat");
	
    traceln("📁 Export : " + file.getAbsolutePath());
	
	
    // 3. ÉCRITURE DES DONNÉES
    java.io.PrintStream ps = new java.io.PrintStream(
        new java.io.FileOutputStream(file));
    ps.println("# === RUN PBFT ===");
ps.println("# p_numNoeuds : " + p_numNoeuds);
ps.println("# p_probaPanne : " + p_probaPanne);
ps.println("# p_mandatLeader : " + p_mandatLeader);
ps.println("# Temps_simulation : " + 
    String.format(java.util.Locale.US, "%.1f", time()));
ps.println("#");
     // EN-TÊTE
	 double timestamp = time();
    int nodeCount = noeuds.size();
    ps.println("# timestamp consensus nodeID nodeCount nbBlocks isConnected votesPrepare votesCommit isLeader isMalveillant activity");
    ps.println("# activity = votesPrepare + votesCommit");

    // DONNÉES PAR NŒUD
    int nbConnectes = 0;
    int maxBlocs = 0;
    int minBlocs = Integer.MAX_VALUE;
    int nbLeaders = 0;
    int nbMalveillants = 0;
    int totalVotesPrepare = 0;
    int totalVotesCommit = 0;
    int totalActivity = 0;

    for (noeud n : noeuds) {
        int nbBlocs = n.blockchain.size();
        int isConnected = n.estConnecte ? 1 : 0;
        int isLeader = n.estLeader ? 1 : 0;
        int isMalveillant = n.estMalveillant ? 1 : 0;
        int activity = n.votesPrepare + n.votesCommit;

        if (isConnected == 1) nbConnectes++;
        if (isLeader == 1) nbLeaders++;
        if (isMalveillant == 1) nbMalveillants++;
        totalVotesPrepare += n.votesPrepare;
        totalVotesCommit += n.votesCommit;
        totalActivity += activity;

        if (nbBlocs > maxBlocs) maxBlocs = nbBlocs;
        if (nbBlocs < minBlocs) minBlocs = nbBlocs;

        ps.println(
            String.format(java.util.Locale.US, "%.1f", timestamp) + " " +
            "PBFT " +
            n.getIndex() + " " +
            nodeCount + " " +
            nbBlocs + " " +
            isConnected + " " +
            n.votesPrepare + " " +
            n.votesCommit + " " +
            isLeader + " " +
            isMalveillant + " " +
            activity
        );
    }

    if (minBlocs == Integer.MAX_VALUE) minBlocs = 0;

    int failures = nodeCount - nbConnectes;
    double throughput = (timestamp > 0) ? ((double) maxBlocs / timestamp) : 0.0;
    int syncGap = maxBlocs - minBlocs;
    double rejectRate = (roundActuel > 0) ? ((double) nbReject / roundActuel) : 0.0;

    ps.println("");
    ps.println("# STATS_GLOBALES");
    ps.println("# consensus : PBFT");
    ps.println("# timestamp : " + String.format(java.util.Locale.US, "%.1f", timestamp));
    ps.println("# nodeCount : " + nodeCount);
    ps.println("# nbConnectes : " + nbConnectes);
    ps.println("# failures : " + failures);
    ps.println("# hauteur_chaine_max : " + maxBlocs);
    ps.println("# hauteur_chaine_min : " + minBlocs);
    ps.println("# syncGap : " + syncGap);
    ps.println("# throughput : " + String.format(java.util.Locale.US, "%.4f", throughput));
    ps.println("# rounds_total : " + roundActuel);
    ps.println("# blocs_valides : " + nbValideGlobal);
    ps.println("# blocs_rejetes : " + nbReject);
    ps.println("# taux_rejet : " + String.format(java.util.Locale.US, "%.4f", rejectRate));
    ps.println("# reponses_client : " + client.reponsesRecues);
    ps.println("# nbLeaders : " + nbLeaders);
    ps.println("# nbMalveillants : " + nbMalveillants);
    ps.println("# totalVotesPrepare : " + totalVotesPrepare);
    ps.println("# totalVotesCommit : " + totalVotesCommit);
    ps.println("# totalActivity : " + totalActivity);

    ps.close();
    traceln("✅ SUCCÈS : Données PBFT exportées dans " + file.getAbsolutePath());

} catch (Exception e) {
    traceln("❌ ERREUR : " + e.getMessage());
}]]></ActionCode>

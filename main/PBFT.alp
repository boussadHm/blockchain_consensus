					<Action><![CDATA[if (!enCoursDeViewChange) {
    enCoursDeViewChange = true; // On verrouille !
    traceln("⏱️ 100 secondes écoulées ! Fin du mandat du Leader " + indexLeader + ".");
    for (noeud n : noeuds) {
        if (n.estConnecte) demanderNouveauLeader(n);
    }
}]]></Action>

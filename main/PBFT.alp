					<TextCode><![CDATA[(this.estLeader ? "👑 " : "") + 
(this.estMalveillant ? "❌ " : "") + 
(this.estConnecte == false ? "HORS LIGNE" : 
    (this.statechart.isStateActive(Attente) ? "ATTENTE" :
     this.statechart.isStateActive(PrePrepare) ? "PRE-PREPARE" :
     this.statechart.isStateActive(Prepare) ? "PREPARE" :
     this.statechart.isStateActive(Commit) ? "COMMIT" :
     this.statechart.isStateActive(Valide) ? "VALIDÉ" : 
     this.statechart.isStateActive(Rejet) ? "REJETÉ" : ""))]]></TextCode>

				<OnArrival><![CDATA[// 1. CLIENT : gestion des réponses reçues par un client
if (cibleClient != null) {
    // Si le message est une réponse valide (REPLY) avec un bloc non frauduleux
    if (typeMessage.equals("REPLY") && blocTransporte != null && !blocTransporte.hash.equals("FAUX_HASH_666")) {
        // Incrémentation du nombre de réponses reçues par le client
        cibleClient.reponsesRecues++;
        
        // Suppression du messager après traitement
        main.remove_messagers(this); 
        return;
    }
}

// Si la cible n'existe pas ou n'est pas connectée → on ignore le message
if (cible == null || !cible.estConnecte) { 
    main.remove_messagers(this); 
    return; 
}

// 2. DÉTECTION DE FRAUDE
// Si le bloc transporté est marqué comme frauduleux
if (blocTransporte != null && blocTransporte.hash.equals("FAUX_HASH_666")) {
    
    // On marque l'expéditeur comme malveillant
    if (expediteur != null) expediteur.estMalveillant = true;  
    
    // Si l'alerte fraude n'a pas encore été déclenchée
    if (!main.alerteFraudeRapportee) { 
        main.alerteFraudeRapportee = true;
        
        // Déclenchement d’un événement/log de fraude
        main.evt_LogFraude.restart(1, SECOND);
    }
}

// 3. GESTION DES REQUÊTES ET DU VIEW-CHANGE

// Cas d'une requête client
if (typeMessage.equals("REQUEST")) {
    main.compteurBatch++;
    
    // Si on atteint 10 requêtes → on déclenche un consensus
    if (main.compteurBatch >= 10) { 
        main.compteurBatch = 0; 
        main.declencherConsensus(); 
    }
    
    main.remove_messagers(this); 
    return;
}

// Cas d’un message de changement de leader (VIEW-CHANGE)
if (typeMessage.equals("VIEW-CHANGE")) {
    
    // Si aucun view-change n'est en cours → on ignore
    if (!main.enCoursDeViewChange) { 
        main.remove_messagers(this); 
        return; 
    }

    // Incrémentation des votes pour le changement de leader
    cible.votesViewChange++;

    // Si quorum atteint → on change de leader
    if (cible.votesViewChange >= main.getQuorum() && main.enCoursDeViewChange) {
        
        // Réinitialisation des votes
        for (noeud n : main.noeuds) n.votesViewChange = 0;

        int tentatives = 0;

        // Recherche d’un nouveau leader connecté
        do { 
            main.indexLeader = (main.indexLeader + 1) % main.noeuds.size(); 
            tentatives++;
        } while (!main.noeuds.get(main.indexLeader).estConnecte && tentatives < main.noeuds.size());

        // Mise à jour des rôles de leader
        for(noeud n : main.noeuds) n.estLeader = false;
        main.noeuds.get(main.indexLeader).estLeader = true;

        // Log du changement de leader
        traceln("🔄 VIEW CHANGE : Nœud " + main.indexLeader + " élu.");

        // Réinitialisation des états
        main.enCoursDeViewChange = false; 
        main.consensusEnCours = false;

        // Redémarrage du mandat du leader
        main.Mandat_Leader.restart(main.p_mandatLeader, SECOND);

        main.remove_messagers(this); 
        return;
    }

    main.remove_messagers(this); 
    return;
}

// 4. PHASES DU PROTOCOLE PBFT

// Si le message appartient à un ancien round → on ignore
if (roundDuMessage < main.roundActuel) { 
    main.remove_messagers(this); 
    return; 
}

// Récupération de l'index de l'expéditeur
int idExp = (expediteur != null) ? expediteur.getIndex() : -1;

// Phase PRE-PREPARE
if (typeMessage.equals("PRE-PREPARE")) {

    // Si le bloc est frauduleux
    if (blocTransporte.hash.equals("FAUX_HASH_666")) { 
        
        // 1. Mise à jour visuelle du nœud (détection fraude)
        cible.statechart.receiveMessage("FRAUDE"); 
        
        // 2. Incrémentation du nombre de rejets
        main.nbReject++;

        // 3. Activation du processus de changement de leader
        main.enCoursDeViewChange = true; 
        main.consensusEnCours = false;

        // 4. Diffusion d’une demande de nouveau leader
        main.demanderNouveauLeader(cible);

        // 5. Nettoyage du messager
        main.remove_messagers(this); 
        return; 
    }

    // Stockage du bloc en cours de traitement
    cible.blocEnCours = blocTransporte;

    // Comptabilisation du vote PREPARE
    if (idExp != -1 && !cible.sendersPrepare.contains(idExp)) { 
        cible.sendersPrepare.add(idExp); 
        cible.votesPrepare++; 
    }

    // Notification au statechart
    cible.statechart.receiveMessage("PRE-PREPARE"); 

// Phases PREPARE et COMMIT
} else if (typeMessage.equals("PREPARE") || typeMessage.equals("COMMIT")) {

    // Vérification de cohérence du bloc
    if (cible.blocEnCours != null && blocTransporte.hash.equals(cible.blocEnCours.hash) && idExp != -1) {
        
        // Phase PREPARE
        if (typeMessage.equals("PREPARE") && !cible.sendersPrepare.contains(idExp)) { 
            cible.sendersPrepare.add(idExp); 
            cible.votesPrepare++; 
            cible.onChange(); 
        }

        // Phase COMMIT
        if (typeMessage.equals("COMMIT") && !cible.sendersCommit.contains(idExp)) { 
            cible.sendersCommit.add(idExp); 
            cible.votesCommit++; 
            cible.onChange(); 
        }
    }
}

// Suppression finale du messager après traitement
main.remove_messagers(this);]]></OnArrival>
